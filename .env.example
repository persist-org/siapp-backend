# Copy to .env for local development: cp .env.example .env

# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=siapp:siapp@tcp(localhost:3306)/siapp?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
REDIS_URL=redis://localhost:6379/0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info
# Run pending migrations when the API starts (development only; refused in production)
MIGRATE_ON_START=true

# Signs access tokens (HS256). At least 32 bytes; generate with: openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET=change-me-change-me-change-me-change-me
# Header in which YOUR reverse proxy puts the real client IP (e.g. X-Forwarded-For).
# Leave empty unless a proxy you control overwrites that header on every request;
# otherwise clients can spoof it and dodge the login rate limit.
CLIENT_IP_HEADER=

# `make seed` creates the first admin from these when no admin exists.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# Tests only: admin connection testkit uses to create one database per test package.
# Needs CREATE/DROP privileges and no database name. Defaults to the docker compose root user.
TEST_MYSQL_DSN=root:root@tcp(localhost:3306)/?parseTime=true&loc=UTC&time_zone=%27%2B00%3A00%27
# Tests only: Redis for the rate limiter. Tests use random key prefixes and never flush it.
TEST_REDIS_URL=redis://localhost:6379/0
