# Copy to .env for local development: cp .env.example .env

APP_ENV=development
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# The API and worker connect as siapp_app (RLS always applies).
DATABASE_URL=postgres://siapp_app:siapp_app@localhost:5432/siapp?sslmode=disable
# Migrations (and the tests' database setup) connect as the owner.
MIGRATE_DSN=postgres://siapp_owner:siapp_owner@localhost:5432/siapp?sslmode=disable
# Development only; refused in production.
MIGRATE_ON_START=false

REDIS_URL=redis://localhost:6379/0

# SiAPP's own access tokens (HS256). At least 32 bytes: openssl rand -base64 48
# This example value works in development only: with APP_ENV=production the API refuses to start
# with it (or with any change-me / low-variety value).
JWT_SECRET=change-me-change-me-change-me-change-me
# Header your reverse proxy sets with the real client IP; leave empty otherwise.
CLIENT_IP_HEADER=

# ---- Photo storage (Phase 04.1) ---------------------------------------------------------
# STORAGE_DRIVER picks where uploaded photos live: local | minio | s3. The app is the same for
# all three (register, PUT the bytes, complete); only the URL it is given differs. Only the
# chosen driver's variables are read, so the other blocks can stay as they are.
STORAGE_DRIVER=local

# local: the files sit on the disk of whatever machine the API runs on, with no extra service.
# Both setups use the same variables, and only these two values differ (docs/dev-setup.md):
#
#                            laptop (make run)              server (containers)
#   STORAGE_LOCAL_DIR        ./data/media (git-ignored)     /var/lib/siapp/media, a bind mount of
#                                                           a host folder such as /srv/siapp/media
#   MEDIA_PUBLIC_BASE_URL    http://localhost:8080          https://<public host>
#
# The API and the worker must see the SAME directory, so the cleanup job can delete files: one
# host, or a shared volume. Nothing replicates it; backing it up is the operator's job.
STORAGE_LOCAL_DIR=./data/media
# Signs the blob URLs (HMAC-SHA256), so whoever has it can mint a URL that reads or writes any
# photo. At least 32 bytes: openssl rand -base64 48
# Like JWT_SECRET, this example value works in development only: production refuses it.
STORAGE_LOCAL_SIGNING_KEY=change-me-change-me-change-me-change-me
# The API's origin AS THE DEVICE SEES IT (blob URLs are built from it). Defaults to
# http://localhost:8080 in development; required in production (the public https origin).
# ⚠ "localhost" on a phone is the phone itself. An Android emulator reaches the laptop at
# http://10.0.2.2:8080, and a real phone on the same Wi-Fi needs the laptop's LAN address
# (for example http://192.168.1.10:8080).
MEDIA_PUBLIC_BASE_URL=http://localhost:8080

# minio: object storage from `make up` (console at http://localhost:9001, minioadmin/minioadmin).
# Uncomment this block and set STORAGE_DRIVER=minio to try the S3 path. It is also what the
# tests use.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=persist-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# # Optional: the host presigned URLs are signed for, when phones cannot resolve the one above
# # (inside compose the API reaches MinIO as http://minio:9000). A phone on the LAN needs the
# # laptop's address, for example http://192.168.1.10:9000.
# # S3_PUBLIC_ENDPOINT=http://192.168.1.10:9000
# # Optional: overrides the driver's default (true for minio, false for s3).
# # S3_FORCE_PATH_STYLE=true

# s3: AWS. S3_ENDPOINT stays unset, so the endpoint of S3_REGION is used (virtual-hosted style).
# STORAGE_DRIVER=s3
# S3_REGION=ap-southeast-3
# S3_BUCKET=persist-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Persist Personel = kpi-personalia-api. Locally, run it on port 8081 (see docs/dev-setup.md);
# the base URL ends in the integration root.
PERSONEL_BASE_URL=http://localhost:8081/api/v3/integrations/siapp
# Shared server-to-server key, sent as X-Integration-Key. Personalia stores only its SHA-256
# (integrations.siapp.key_hashes in its config). Dev value: see docs/dev-setup.md.
PERSONEL_INTEGRATION_KEY=dev-siapp-integration-key
PERSONEL_WEBHOOK_SECRET=change-me-webhook-secret

# The group is ONE organization (D17): the Personalia company ids (m_companies.id) of KPI, IDS
# and PCD. People of any other company cannot sign in.
GROUP_COMPANY_IDS=3,45,89
GROUP_ORGANIZATION_ID=1
# GROUP_ORGANIZATION_NAME=KPI Group  (optional; leave it commented: .env is read by make and by the shell, which disagree about spaces)

# Where make contract copies the PERSIST contract from
CONTRACT_SRC=../persist-ecosystem/contracts/openapi.yaml

# Later phases add: ATTENDANCE_QR_SECRET, FCM_SERVICE_ACCOUNT_BASE64, CCTV_ENCRYPTION_KEY,
# CCTV_GATEWAY_PUBLIC_URL, CCTV_GATEWAY_SHARED_SECRET, QR_IDENTITY_SECRET.
